# Installed packages (recreate with `npm install`)
node_modules/

# Compiled output (recreate with `npm run build`)
dist/

# Everything in data/ stays out of git (backups, pictures, SQLite's temporary
# files), except the database itself, so the price history is saved to GitHub.
*.db
*.db-journal
*.db-wal
*.db-shm
data/*
!data/skins.db

# Secrets like API keys
.env

# Logs and OS clutter
*.log
.DS_Store
Thumbs.db
